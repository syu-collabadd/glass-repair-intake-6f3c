# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Public base URL used for Twilio webhook signature verification
TWILIO_WEBHOOK_BASE_URL=https://your-burrow-slug.burrowapps.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Dashboard auth (set a strong random string)
DASHBOARD_TOKEN=change-me-to-a-long-random-secret

# Optional: Anthropic API for AI lead summaries
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Server
PORT=8022
NODE_ENV=production
